SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///cvboost.db
COOKIE_SECURE=false
DOMAIN=

# ── Multi-Fournisseurs IA (Fallback prioritaire : Gemini -> Groq -> Mistral) ──
# 1. Google Gemini (Priorité 1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Groq (Priorité 2 - Fallback automatique si quota Gemini atteint)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
ASSISTANT_RATE_LIMIT_PER_MINUTE=10

# ── Traduction locale optionnelle français-lingala ──
NLLB_BASE_MODEL=facebook/nllb-200-distilled-600M
# Copy the trained adapter from Colab/Google Drive into this ignored local folder.
NLLB_ADAPTER_PATH=ai_engine/models/nllb-lora-lin-fra

# 3. Mistral AI (Priorité 3 - Fallback automatique si quotas Gemini & Groq atteints)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Données et Pipeline ──
JOB_OFFERS_FILE=data_pipeline/jobs_clean.csv
JOB_ADMIN_EMAILS=
MEDIACONGO_COLLECTION_APPROVED=false

# Job alerts are sent only to users who enable them in their preferences.
JOB_ALERTS_ENABLED=false
JOB_ALERT_SMTP_HOST=
JOB_ALERT_SMTP_PORT=587
JOB_ALERT_SMTP_USERNAME=
JOB_ALERT_SMTP_PASSWORD=
JOB_ALERT_SMTP_USE_TLS=true
JOB_ALERT_SMTP_USE_SSL=false
JOB_ALERT_FROM_EMAIL=
