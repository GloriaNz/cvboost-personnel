SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///cvboost.db
COOKIE_SECURE=false
DOMAIN=

# ── Multi-Fournisseurs IA (Fallback prioritaire : Gemini -> Groq -> Mistral) ──
# 1. Google Gemini (Priorité 1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 2. Groq (Priorité 2 - Fallback automatique si quota Gemini atteint)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# 3. Mistral AI (Priorité 3 - Fallback automatique si quotas Gemini & Groq atteints)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── Données et Pipeline ──
JOB_OFFERS_FILE=data_pipeline/jobs_clean.csv
